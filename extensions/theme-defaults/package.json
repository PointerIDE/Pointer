{
	"name": "theme-defaults",
	"displayName": "%displayName%",
	"description": "%description%",
	"categories": [
		"Themes"
	],
	"version": "10.0.0",
	"publisher": "vscode",
	"license": "MIT",
	"engines": {
		"vscode": "*"
	},
	"contributes": {
		"themes": [
			{
				"id": "Pointer Dark",
				"label": "%pointerDarkThemeLabel%",
				"uiTheme": "vs-dark",
				"path": "./themes/pointer-dark.json"
			},
			{
				"id": "Pointer Obsidian",
				"label": "%pointerObsidianThemeLabel%",
				"uiTheme": "vs-dark",
				"path": "./themes/pointer-obsidian.json"
			},
			{
				"id": "Pointer Cyber",
				"label": "%pointerCyberThemeLabel%",
				"uiTheme": "vs-dark",
				"path": "./themes/pointer-cyber.json"
			},
			{
				"id": "Pointer Light",
				"label": "%pointerLightThemeLabel%",
				"uiTheme": "vs",
				"path": "./themes/pointer-light.json"
			}
		],
		"iconThemes": [
			{
				"id": "vs-minimal",
				"label": "%minimalIconThemeLabel%",
				"path": "./fileicons/vs_minimal-icon-theme.json"
			}
		]
	},
	"repository": {
		"type": "git",
		"url": "https://github.com/PointerIDE/Pointer.git"
	}
}
