{
	"$schema": "vscode://schemas/color-theme",
	"name": "Pointer Obsidian",
	"include": "./pointer-dark.json",
	"type": "dark",
	"colors": {
		"focusBorder": "#8B83FF",
		"button.background": "#EDEBFF",
		"button.foreground": "#09080D",
		"button.hoverBackground": "#D7D2FF",
		"badge.background": "#8B83FF",
		"badge.foreground": "#08070C",
		"progressBar.background": "#8B83FF",
		"activityBar.background": "#020203",
		"activityBar.border": "#191821",
		"activityBar.activeBorder": "#8B83FF",
		"sideBar.background": "#050507",
		"sideBar.border": "#191821",
		"titleBar.activeBackground": "#020203",
		"titleBar.inactiveBackground": "#020203",
		"titleBar.border": "#191821",
		"commandCenter.background": "#09090D",
		"commandCenter.border": "#292637",
		"commandCenter.activeBorder": "#8B83FF",
		"editor.background": "#000000",
		"editorGutter.background": "#000000",
		"editor.lineHighlightBackground": "#8B83FF0A",
		"editor.selectionBackground": "#8B83FF32",
		"editorCursor.foreground": "#B5AFFF",
		"editorWidget.background": "#09090D",
		"editorWidget.border": "#292637",
		"panel.background": "#000000",
		"panel.border": "#191821",
		"panelTitle.activeBorder": "#8B83FF",
		"statusBar.background": "#020203",
		"statusBar.border": "#191821",
		"tab.activeBackground": "#000000",
		"tab.inactiveBackground": "#050507",
		"tab.activeBorderTop": "#8B83FF",
		"editorGroupHeader.tabsBackground": "#050507",
		"terminal.background": "#000000",
		"chat.requestBubbleBackground": "#8B83FF0D",
		"agents.background": "#000000",
		"agentsPanel.background": "#050507",
		"agentsGradient.tintColor": "#8B83FF",
		"agentsChatInput.background": "#09090D",
		"agentsChatInput.focusBorder": "#8B83FF"
	},
	"tokenColors": [
		{ "scope": ["keyword", "storage.type", "storage.modifier"], "settings": { "foreground": "#A99FFF" } },
		{ "scope": ["string", "string.quoted"], "settings": { "foreground": "#A9D5C2" } },
		{ "scope": ["entity.name.function", "support.function"], "settings": { "foreground": "#D0C7FF" } }
	]
}
