	"tokenColors": [
		{
			"scope": ["comment", "punctuation.definition.comment"],
			"settings": { "foreground": "#777777", "fontStyle": "italic" }
		},
		{
			"scope": ["keyword", "storage", "storage.type", "storage.modifier"],
			"settings": { "foreground": "#000000", "fontStyle": "bold" }
		},
		{
			"scope": ["string", "constant.character", "markup.inline.raw"],
			"settings": { "foreground": "#333333" }
		},
		{
			"scope": ["constant", "constant.numeric", "support.constant"],
			"settings": { "foreground": "#555555" }
		},
		{
			"scope": ["entity.name.function", "support.function", "variable.function"],
			"settings": { "foreground": "#161616" }
		},
		{
			"scope": ["entity.name.type", "entity.name.class", "support.type", "support.class"],
			"settings": { "foreground": "#282828" }
		},
		{
			"scope": ["variable", "variable.other", "entity.other.attribute-name", "meta.object-literal.key"],
			"settings": { "foreground": "#444444" }
		},
		{
			"scope": ["invalid", "invalid.illegal"],
			"settings": { "foreground": "#B42323" }
		},
		{
			"scope": ["markup.bold"],
			"settings": { "foreground": "#000000", "fontStyle": "bold" }
		},
		{
			"scope": ["markup.italic"],
			"settings": { "foreground": "#333333", "fontStyle": "italic" }
		}
	],
	"semanticHighlighting": true,
	"semanticTokenColors": {
		"comment": { "foreground": "#777777", "italic": true },
		"keyword": { "foreground": "#000000", "bold": true },
		"string": "#333333",
		"number": "#555555",
		"function": "#161616",
		"type": "#282828",
		"class": "#282828",
		"variable": "#444444"
	}
}
