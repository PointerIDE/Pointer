	"tokenColors": [
		{
			"scope": ["comment", "punctuation.definition.comment"],
			"settings": { "foreground": "#737373", "fontStyle": "italic" }
		},
		{
			"scope": ["keyword", "storage", "storage.type", "storage.modifier"],
			"settings": { "foreground": "#FFFFFF", "fontStyle": "bold" }
		},
		{
			"scope": ["string", "constant.character", "markup.inline.raw"],
			"settings": { "foreground": "#D0D0D0" }
		},
		{
			"scope": ["constant", "constant.numeric", "support.constant"],
			"settings": { "foreground": "#B8B8B8" }
		},
		{
			"scope": ["entity.name.function", "support.function", "variable.function"],
			"settings": { "foreground": "#F2F2F2" }
		},
		{
			"scope": ["entity.name.type", "entity.name.class", "support.type", "support.class"],
			"settings": { "foreground": "#E0E0E0" }
		},
		{
			"scope": ["variable", "variable.other", "entity.other.attribute-name", "meta.object-literal.key"],
			"settings": { "foreground": "#C7C7C7" }
		},
		{
			"scope": ["invalid", "invalid.illegal"],
			"settings": { "foreground": "#FF8585" }
		},
		{
			"scope": ["markup.bold"],
			"settings": { "foreground": "#FFFFFF", "fontStyle": "bold" }
		},
		{
			"scope": ["markup.italic"],
			"settings": { "foreground": "#D0D0D0", "fontStyle": "italic" }
		}
	],
	"semanticHighlighting": true,
	"semanticTokenColors": {
		"comment": { "foreground": "#737373", "italic": true },
		"keyword": { "foreground": "#FFFFFF", "bold": true },
		"string": "#D0D0D0",
		"number": "#B8B8B8",
		"function": "#F2F2F2",
		"type": "#E0E0E0",
		"class": "#E0E0E0",
		"variable": "#C7C7C7"
	}
}
