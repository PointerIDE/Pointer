{
	"$schema": "vscode://schemas/color-theme",
	"name": "Pointer Cyber",
	"include": "./pointer-dark.json",
	"type": "dark",
	"colors": {
		"foreground": "#DDEFF2",
		"descriptionForeground": "#78939A",
		"icon.foreground": "#8EBAC2",
		"focusBorder": "#48D7E8",
		"textLink.foreground": "#59DDEB",
		"button.background": "#48D7E8",
		"button.foreground": "#031014",
		"button.hoverBackground": "#75E5F0",
		"badge.background": "#48D7E8",
		"badge.foreground": "#031014",
		"progressBar.background": "#48D7E8",
		"activityBar.background": "#061014",
		"activityBar.border": "#173038",
		"activityBar.activeBorder": "#48D7E8",
		"sideBar.background": "#071217",
		"sideBar.border": "#173038",
		"titleBar.activeBackground": "#061014",
		"titleBar.inactiveBackground": "#061014",
		"titleBar.border": "#173038",
		"commandCenter.background": "#0B1A20",
		"commandCenter.border": "#24434A",
		"commandCenter.activeBorder": "#48D7E8",
		"editor.background": "#071115",
		"editor.foreground": "#D6E8EB",
		"editorGutter.background": "#071115",
		"editor.lineHighlightBackground": "#48D7E80A",
		"editor.selectionBackground": "#48D7E82B",
		"editorCursor.foreground": "#69E8F4",
		"editorWidget.background": "#0B1A20",
		"editorWidget.border": "#24434A",
		"panel.background": "#071115",
		"panel.border": "#173038",
		"panelTitle.activeBorder": "#48D7E8",
		"statusBar.background": "#061014",
		"statusBar.border": "#173038",
		"tab.activeBackground": "#071115",
		"tab.inactiveBackground": "#09171C",
		"tab.activeBorderTop": "#48D7E8",
		"editorGroupHeader.tabsBackground": "#09171C",
		"terminal.background": "#050D10",
		"chat.requestBubbleBackground": "#48D7E80D",
		"agents.background": "#071115",
		"agentsPanel.background": "#071217",
		"agentsGradient.tintColor": "#48D7E8",
		"agentsChatInput.background": "#0B1A20",
		"agentsChatInput.focusBorder": "#48D7E8"
	},
	"tokenColors": [
		{ "scope": ["keyword", "storage.type", "storage.modifier"], "settings": { "foreground": "#55DDEA" } },
		{ "scope": ["string", "string.quoted"], "settings": { "foreground": "#9ED6A5" } },
		{ "scope": ["entity.name.function", "support.function"], "settings": { "foreground": "#A7C7FF" } },
		{ "scope": ["constant.numeric", "constant.language"], "settings": { "foreground": "#E8B86D" } }
	]
}
